{
  "name": "gdg-pup-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=!identity-api... --filter=!@packages/identity-api-contracts",
    "dev:nexus": "turbo dev --filter=nexus-api... --filter=nexus-web...",
    "dev:nexus-api": "turbo dev --filter=nexus-api... --filter=nexus-admin-web...",
    "dev:backend": "turbo dev --filter=nexus-api... --filter=nexus-admin-web...",
    "dev:storybook": "turbo dev --filter=storybook...",
    "build": "turbo run build --filter=!storybook --filter=!identity-api... --filter=!@packages/identity-api-contracts",
    "build:nexus": "turbo build  --filter=nexus-api... --filter=nexus-web...",
    "start": "turbo run start --filter=!identity-api...",
    "clean": "node scripts/clean/detect-shell.ts",
    "reinstall": "pnpm clean && pnpm install",
    "gen-types": "turbo run gen-types --filter=!identity-api... --filter=!@packages/identity-api-contracts",
    "gen-types:rebuild": "pnpm gen-types && pnpm build",
    "rebuild-install": "pnpm reinstall && pnpm gen-types:rebuild",
    "lint": "turbo run lint --filter=!identity-api...",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test --filter=!identity-api..."
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "prettier": "3.7.4",
    "syncpack": "13.0.4",
    "turbo": "2.7.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "clsx": "^2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "^6.1.3",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0"
  }
}
